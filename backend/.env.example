DATABASE_URL="file:./dev.db"
# Use a long random string in production (required when NODE_ENV=production)
JWT_SECRET="ala-penca-dev-secret-change-me"
PORT=3000
NODE_ENV=development

# Comma-separated frontend origins in production, e.g. https://alapenca.com
# Leave empty in development to allow all local origins.
CORS_ORIGIN=

# WhatsApp order notifications (Twilio) — disabled for now
NOTIFY_ENABLED=false
NOTIFY_PHONES="+525580225475,+525539286932"
NOTIFY_LOG_ONLY=true
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=""
